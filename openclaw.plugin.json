{
  "id": "opencode-fleet",
  "name": "OpenCode Fleet",
  "description": "Orchestrate OpenCode across multiple remote OpenClaw nodes (dev2, dev3, ...). Dispatch coding tasks, check fleet status, abort runaway sessions, and pull diffs over the authenticated node channel.",
  "version": "0.1.0",
  "kind": "plugin",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "defaultTransport": {
        "type": "string",
        "enum": [
          "http",
          "acp"
        ],
        "default": "http"
      },
      "nodePrefixes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "dev"
        ],
        "description": "Fallback: prefixes treated as fleet members when nodes is not configured"
      },
      "defaultTimeoutMs": {
        "type": "number",
        "default": 300000
      },
      "nodes": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ssh": {
              "type": "boolean"
            },
            "platform": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "skills": [
    "skills/opencode-fleet"
  ],
  "contracts": {
    "tools": [
      "fleet_dispatch",
      "fleet_watch",
      "fleet_answer",
      "fleet_iterate",
      "fleet_status",
      "fleet_abort",
      "fleet_diff",
      "fleet_models",
      "fleet_activity",
      "fleet_provision",
      "fleet_sync",
      "fleet_cleanup",
      "fleet_capabilities",
      "fleet_provision_config",
      "fleet_recipe_recommend",
      "fleet_recipe_record",
      "fleet_recipe_list",
      "fleet_deploy",
      "fleet_resume",
      "fleet_run_status"
    ]
  }
}